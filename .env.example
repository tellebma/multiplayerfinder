# Server-side only. Never put the service role key in public/ or in client JavaScript.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SECRET_KEY
PORT=8765
# 0.0.0.0 enables access from other devices on the local network.
# Set HOST=127.0.0.1 to restrict access to this computer.
HOST=0.0.0.0
# Canonical URL for Steam OpenID callbacks. Use http://localhost:8765 locally.
APP_URL=https://multiplayerfinder.vercel.app
# Optional for retrieving Steam friends (server-side only).
STEAM_WEB_API_KEY=
